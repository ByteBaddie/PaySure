  .brand-mark img { width: 100%; height: 100%; object-fit: contain; }
  .brand-name {
    font-weight: 800;
    font-size: 18.5px;
    letter-spacing: -0.015em;
    background: linear-gradient(155deg, var(--text), var(--text-muted));
