    background-clip: text;
  }
  .brand-sub { font-size: 11.5px; color: var(--text-faint); margin-top: -2px; letter-spacing: .01em; }

  .theme-toggle {
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text-muted);
    border-radius: 100px;
    padding: 6px 12px;
    font-size: 12px;
    font-family: var(--font-ui);
