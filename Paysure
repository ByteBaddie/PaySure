  .shell {
    max-width: 640px;
    margin: 0 auto;
    padding: 20px 16px 90px;
    position: relative;
  }

  header.top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 2px 20px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .brand-mark {
    width: 46px; height: 46px;
